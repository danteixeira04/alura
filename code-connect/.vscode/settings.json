{
  // ============= Geral do editor =============
  "locale": "pt-BR",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ============= Code Actions on save =============
  // ESLint corrige arquivos do apps/api; Oxlint corrige arquivos do apps/web
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.oxc": "explicit"
  },

  // ============= TypeScript =============
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.suggest.autoImports": true,
  "javascript.suggest.autoImports": true,

  // ============= ESLint (NestJS) =============
  "eslint.useFlatConfig": true,
  "eslint.workingDirectories": ["apps/api"],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // ============= Oxlint (Vite/React) =============
  "oxc.enable": true,
  "oxc.lint.run": "onSave",

  // ============= Prettier =============
  "prettier.requireConfig": true,

  // ============= Workspace monorepo =============
  "npm.packageManager": "pnpm",
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.pnpm-store": true,
    "**/coverage": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/dist": true
  },

  // ============= Explorer =============
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, pnpm-lock.yaml, .npmrc, pnpm-workspace.yaml, .gitignore, .gitattributes, .editorconfig, .prettierrc, .prettierignore, .oxlintrc.json, .eslintrc*, eslint.config.*",
    "tsconfig.json": "tsconfig.*.json"
  },

  // ============= Terminal integrado =============
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.splitCwd": "workspaceRoot",
  "terminal.integrated.enablePersistentSessions": false

  // ============= Sincronizar settings entre maquinas (opcional) =============
  // "settingsSync.ignoredSettings": []
}
